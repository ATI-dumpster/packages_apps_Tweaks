<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top section with wallpaper and cards -->
    <LinearLayout
        android:id="@+id/quick_access_widgets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- Main Card with wallpaper -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/wallpaper_card"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_weight="1"
            android:clickable="true"
            app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Wallpaper Preview Container -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/wallpaper_card"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginBottom="7dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <com.android.tweaks.utils.BlurWallpaperView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/clockface_card"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="7dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <TextClock
                        android:id="@+id/card_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:format12Hour="h:mm"
                        android:textColor="?android:colorAccent"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Right column cards -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top card -->
            <RelativeLayout
                android:id="@+id/themes_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:background="@drawable/everest_background_single">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1.0"
                    android:gravity="start|center"
                    android:orientation="horizontal"
                    android:padding="5dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="start | center"
                        android:background="@drawable/everest_adaptive_shape"
                        android:backgroundTint="?android:colorAccent"
                        android:padding="8dp"
                        android:src="@drawable/ic_tweaks_themes"
                        android:tint="?android:colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start | center"
                        android:ellipsize="marquee"
                        android:fontFamily="@*android:string/config_headlineFontFamily"
                        android:singleLine="true"
                        android:text="Themes"
                        android:layout_marginStart="12dp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Bottom card -->
            <RelativeLayout
                android:id="@+id/fonts_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="7dp"
                android:layout_weight="1"
                android:background="@drawable/everest_background_single">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1.0"
                    android:gravity="start|center"
                    android:orientation="horizontal"
                    android:padding="5dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="start | center"
                        android:background="@drawable/everest_adaptive_shape"
                        android:backgroundTint="?android:colorAccent"
                        android:padding="8dp"
                        android:src="@drawable/ic_tweaks_fonts"
                        android:tint="?android:colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start | center"
                        android:ellipsize="marquee"
                        android:fontFamily="@*android:string/config_headlineFontFamily"
                        android:singleLine="true"
                        android:layout_marginStart="12dp"
                        android:text="Fonts"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
